{
  "name": "helives",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "He Lives: a free, accessible library of the Berean Standard Bible, the church fathers, Augustine, Aquinas, the creeds and more.",
  "homepage": "https://helives.dev/",
  "repository": {
    "type": "git",
    "url": "https://github.com/baney75/helives"
  },
  "license": "MIT",
  "scripts": {
    "build": "node site/build.mjs",
    "test": "node --test site/test/*.test.mjs && python3 -m unittest discover -s pipeline/tests -t . && vitest run worker",
    "typecheck": "tsc -p tsconfig.worker.json --pretty false",
    "lint": "oxlint site worker",
    "validate": "python3 pipeline/validate.py",
    "md": "python3 pipeline/render_md.py",
    "search-index": "node site/search-index.mjs",
    "dev": "pnpm build && wrangler dev --port 8841",
    "deploy": "pnpm build && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260813.1",
    "@fontsource-variable/atkinson-hyperlegible-next": "5.2.6",
    "@fontsource-variable/source-serif-4": "5.2.9",
    "@fontsource/opendyslexic": "5.3.0",
    "oxlint": "^1.75.0",
    "playwright": "^1.55.0",
    "smol-toml": "1.9.1",
    "typescript": "~6.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.149.0"
  }
}
