{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "helives",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-12",
  "account_id": "f28b2a55054cbc8d998c5963ed34a0a7",
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "helives-library", "database_id": "70369c69-f04e-4f91-bb80-e87843b1de8a" }
  ],
  "r2_buckets": [{ "binding": "AUDIO", "bucket_name": "helives-audio" }],
  "routes": [
    { "pattern": "helives.dev", "custom_domain": true },
    { "pattern": "www.helives.dev", "custom_domain": true }
  ]
}
