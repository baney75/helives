{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "helives",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-12",
  "account_id": "f28b2a55054cbc8d998c5963ed34a0a7",
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "helives.dev", "custom_domain": true },
    { "pattern": "www.helives.dev", "custom_domain": true }
  ]
}
